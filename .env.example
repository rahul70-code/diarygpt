PORT=3000

# 32-byte key as 64 hex characters — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_key_here

# Secret for signing JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://dairygpt:dairygpt@localhost:5432/dairygpt

# Default API keys (used when no custom key is set via /api/config)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
